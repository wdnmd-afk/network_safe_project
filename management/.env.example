# 管理端服务环境变量示例。
# 复制为 apps/admin-server/.env 后按本机实际情况修改；.env 已被 .gitignore 忽略。
# 该文件只放示例值，禁止写入真实密钥。

# 必须与 network_safe_project 的 apps/server/.env 指向同一个库。
# 管理端只读主项目业务表，唯一写入例外是 labs.is_enabled 与 lab_variants.is_enabled。
DATABASE_URL=mysql://root:password@localhost:3306/network_safe_project

# 管理端会话令牌签名密钥。必须与主项目 AUTH_TOKEN_SECRET 不同，
# 否则主站 token 可直接用于管理端。
ADMIN_TOKEN_SECRET=replace-with-local-random-value

# 会话令牌有效期（秒）。默认 28800 即 8 小时。
ADMIN_TOKEN_TTL_SECONDS=28800

# 监听地址与端口。只允许回环地址，写其它值服务会拒绝启动。
ADMIN_SERVER_HOST=127.0.0.1
ADMIN_SERVER_PORT=6681

# 运行环境标识。
APP_ENV=development
