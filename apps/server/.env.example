# 本机后端服务环境变量示例。
# 复制为 apps/server/.env 后按本机实际情况修改；.env 已被 .gitignore 忽略。
# 该文件只放示例值，禁止写入真实密钥与个人凭据。

# 后端监听端口。前端开发服务器与 nginx 模板默认按 6667 反向代理。
PORT=6667

# 运行环境标识。development 时 AUTH_TOKEN_SECRET 缺失会回落为随机值；
# production 时缺失会直接启动失败。
APP_ENV=development

# 允许的前端来源。与前端开发端口（apps/web/src/config/runtime.ts 中 webDevPort=6670）保持一致。
WEB_ORIGIN=http://localhost:6670

# 会话令牌签名密钥。本机学习用示例值，正式使用请替换为本机随机值。
AUTH_TOKEN_SECRET=network-safe-local-dev-secret

# 会话令牌有效期（秒）。默认 28800 即 8 小时；非正整数会回落为默认值。
AUTH_TOKEN_TTL_SECONDS=28800

# 本机 MySQL 连接串。用户名、密码、库名按本机实际情况修改。
DATABASE_URL="mysql://root:password@localhost:3306/network_safe_project"

# 可选：mysql 命令行可执行文件路径。
# database/scripts/apply-migrations.mjs 默认在 PATH 中查找 mysql；
# 若 MySQL 未加入 PATH，用该变量显式指定，避免把本机路径写进代码。
# 示例（Windows）：MYSQL_CLI_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
# MYSQL_CLI_PATH=
